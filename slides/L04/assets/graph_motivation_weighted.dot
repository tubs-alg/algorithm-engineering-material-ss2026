digraph RouteGraph {

graph [
  bgcolor="transparent",
  rankdir="LR",
  pad="0.10",
  nodesep="0.30",
  ranksep="0.48",
  dpi="200",
  fontname="Helvetica"
];
node [
  shape="box",
  style="filled,rounded",
  color="#e0e0e0",
  fontcolor="white",
  penwidth="1.2",
  fontname="Helvetica-Bold",
  fontsize="20",
  margin="0.14,0.10"
];
edge [
  color="#f39c12",
  fontcolor="#f5c97b",
  penwidth="1.8",
  arrowsize="0.75",
  fontsize="14",
  fontname="Helvetica"
];

          label=<
            <FONT POINT-SIZE="24"><B>Weighted directed graph</B></FONT><BR/>
            <FONT POINT-SIZE="14">route planning / travel times / latency</FONT>
          >;
          labelloc="t";
          labeljust="l";

            rA [label="Depot", fillcolor="#3a6b8c"];
            rB [label="Hub", fillcolor="#4ea8de"];
            rC [label="Bridge", fillcolor="#4ea8de"];
            rD [label="Airport", fillcolor="#8e5ea2"];
            { rank=same; rA; rB; rC; rD; }
            rA -> rB [label="7 min"];
            rA -> rC [label="11 min"];
            rB -> rC [label="3 min"];
            rC -> rB [label="5 min", color="#9fb3c8", fontcolor="#b8c0cc"];
            rB -> rD [label="9 min"];
            rC -> rD [label="4 min"];

        }
