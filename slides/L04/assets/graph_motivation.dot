digraph GraphMotivation {
  graph [
    bgcolor="transparent",
    rankdir="LR",
    compound="true",
    newrank="true",
    pad="0.12",
    nodesep="0.30",
    ranksep="0.55",
    dpi="200",
    fontname="Helvetica"
  ];

  node [
    shape="box",
    style="filled,rounded",
    color="#e0e0e0",
    fontcolor="white",
    penwidth="1.2",
    fontname="Helvetica-Bold",
    fontsize="16",
    margin="0.12,0.08"
  ];

  edge [
    color="#f39c12",
    fontcolor="#f5c97b",
    penwidth="1.5",
    arrowsize="0.7",
    fontsize="12",
    fontname="Helvetica"
  ];

  label=<
    <FONT POINT-SIZE="22"><B>One abstraction, many graph flavours</B></FONT><BR/>
    <FONT POINT-SIZE="13">weighted routing, directed citations, dependency DAGs, bipartite flow networks</FONT>
  >;
  labelloc="t";
  labeljust="l";

  subgraph cluster_route {
    label=<
      <B>Weighted directed graph</B><BR/><FONT POINT-SIZE="12">route planning / travel times</FONT>
    >;
    color="#5a6680";
    penwidth="1.2";
    style="rounded";

    rA [label="Depot", fillcolor="#3a6b8c"];
    rB [label="Hub", fillcolor="#4ea8de"];
    rC [label="Bridge", fillcolor="#4ea8de"];
    rD [label="Airport", fillcolor="#8e5ea2"];

    { rank=same; rA; rB; rC; rD; }

    rA -> rB [label="7 min"];
    rA -> rC [label="11 min"];
    rB -> rC [label="3 min"];
    rC -> rB [label="5 min", color="#9fb3c8", fontcolor="#b8c0cc"];
    rB -> rD [label="9 min"];
    rC -> rD [label="4 min"];
  }

  subgraph cluster_cite {
    label=<
      <B>Directed graph</B><BR/><FONT POINT-SIZE="12">citation / influence / hyperlinks</FONT>
    >;
    color="#5a6680";
    penwidth="1.2";
    style="rounded";

    c1 [label="Transformer\n(2017)", fillcolor="#3a6b8c"];
    c2 [label="BERT\n(2018)", fillcolor="#5a9e5a"];
    c3 [label="GPT\n(2018)", fillcolor="#5a9e5a"];
    c4 [label="Modern\nsurvey", fillcolor="#8e5ea2"];

    { rank=same; c1; c2; c3; c4; }

    c2 -> c1;
    c3 -> c1;
    c4 -> c2;
    c4 -> c3;
  }

  subgraph cluster_build {
    label=<
      <B>DAG</B><BR/><FONT POINT-SIZE="12">build systems / task scheduling / prerequisites</FONT>
    >;
    color="#5a6680";
    penwidth="1.2";
    style="rounded";

    b1 [label="lexer.o", fillcolor="#3a6b8c"];
    b2 [label="parser.o", fillcolor="#3a6b8c"];
    b3 [label="frontend.a", fillcolor="#4ea8de"];
    b4 [label="app", fillcolor="#8e5ea2"];

    { rank=same; b1; b2; b3; b4; }

    b1 -> b3;
    b2 -> b3;
    b3 -> b4;
  }

  subgraph cluster_flow {
    label=<
      <B>Bipartite / capacitated graph</B><BR/><FONT POINT-SIZE="12">matching, logistics, max-flow</FONT>
    >;
    color="#5a6680";
    penwidth="1.2";
    style="rounded";

    s  [label="Source", fillcolor="#3a6b8c"];
    w1 [label="Warehouse 1", fillcolor="#5a9e5a"];
    w2 [label="Warehouse 2", fillcolor="#5a9e5a"];
    t  [label="Customers", fillcolor="#8e5ea2"];

    { rank=same; s; w1; w2; t; }

    s  -> w1 [label="cap 8"];
    s  -> w2 [label="cap 5"];
    w1 -> t  [label="cost 2"];
    w2 -> t  [label="cost 3"];
  }
}
